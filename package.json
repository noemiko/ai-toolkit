{
  "name": "@noemiko/ai-toolkit",
  "version": "0.1.0",
  "description": "Team AI artifacts distributed through GitHub Packages",
  "license": "UNLICENSED",
  "type": "commonjs",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "skills/",
    "rules/",
    "install.js",
    "uninstall.js",
    "README.md"
  ],
  "scripts": {
    "postinstall": "node install.js",
    "test": "node --test",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "npm run lint -- --fix"
  },
  "bin": {
    "ai-toolkit": "./install.js",
    "ai-toolkit-uninstall": "./uninstall.js"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noemiko/ai-toolkit.git"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "globals": "17.14.0"
  }
}
